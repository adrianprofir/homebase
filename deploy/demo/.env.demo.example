# Copy to .env next to compose.yml in this directory, fill in, and chmod 600 it.
# See docs/demo.md. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# This is a public demo. DEMO_MODE is set by compose.yml and must stay on. homebase refuses
# to start in demo mode while any provider token or EMAIL_HOST is set, so this file carries none.

SECRET_KEY=change-me
# Use a URL-safe value, for example: openssl rand -hex 32
POSTGRES_PASSWORD=change-me

# Public hostname the demo is served on, without a scheme.
DEMO_HOSTNAME=homebase-demo.example

# External Docker network shared with the reverse proxy or tunnel. Create it once with
# `docker network create <name>`.
DEMO_EDGE_NETWORK=homebase-demo-edge
# Name the proxy or tunnel uses to reach this demo: http://<alias>:8000. Must be unique on
# the edge network, so never web or db.
DEMO_EDGE_ALIAS=homebase-demo-web

# Loopback-only port for smoke tests from the host.
DEMO_SMOKE_PORT=8094

# Optional: a strip above the header linking to the site this demo belongs to.
MAIN_SITE_URL=

# --- Optional ---
# Hour of the day (00-23, container time, UTC) when the demo is rebuilt.
DEMO_RESET_HOUR=03
# Seconds between simulated checks.
CHECK_INTERVAL_SECONDS=300
TIME_ZONE=UTC
# Set both to false/0 only when the demo is not served over HTTPS.
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
