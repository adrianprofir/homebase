# Copy to .env and fill in. Never commit .env.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
SECRET_KEY=change-me
DEBUG=false
# Hostnames and IPs the dashboard is reached by, comma separated (for example the home server's LAN IP).
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins (scheme://host[:port]) allowed to submit forms. Only needed behind a reverse proxy.
CSRF_TRUSTED_ORIGINS=
# Behind a reverse proxy that terminates HTTPS: set SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE
# to true, and TRUST_X_FORWARDED_PROTO=true when the proxy sets X-Forwarded-Proto and clients
# cannot reach homebase directly. SECURE_SSL_REDIRECT sends plain HTTP to HTTPS (/healthz is exempt),
# and SECURE_HSTS_SECONDS turns on HSTS; start small, browsers remember it.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
TRUST_X_FORWARDED_PROTO=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- Inventory behaviour ---
HOMEBASE_DEFAULT_CURRENCY=USD
HOMEBASE_RENEWAL_WINDOW_DAYS=60
HOMEBASE_CHECK_TIMEOUT_SECONDS=10
# Days of uptime history to keep.
HOMEBASE_CHECK_HISTORY_DAYS=90

# --- Provider APIs (read-only; see "Provider tokens" in README.md) ---
# Each provider is optional. Leave a token empty to skip that provider.
CLOUDFLARE_API_TOKEN=
# Only needed to list tunnels when the Cloudflare token can see no zones.
CLOUDFLARE_ACCOUNT_ID=
GODADDY_API_TOKEN=
DIGITALOCEAN_API_TOKEN=
HOSTINGER_API_TOKEN=
# Minutes between provider syncs, and the timeout for each API request.
HOMEBASE_SYNC_INTERVAL_MINUTES=60
HOMEBASE_SYNC_TIMEOUT_SECONDS=30

# --- Alerts ---
# Manual renewals (domains, subscriptions) warn this many days ahead. Everything turns critical at 7 days.
HOMEBASE_EXPIRY_ALERT_DAYS=30
# TLS certificates warn this many days ahead and turn critical at 3 days.
HOMEBASE_TLS_ALERT_DAYS=10
# A live app alerts after failing its checks for this many minutes.
HOMEBASE_DOWNTIME_ALERT_MINUTES=10
# Alert email. Off unless EMAIL_HOST and HOMEBASE_ALERT_EMAIL_TO are both set.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# STARTTLS on EMAIL_PORT (587). For implicit TLS on port 465 set EMAIL_USE_TLS=false and EMAIL_USE_SSL=true.
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=homebase@localhost
# Comma-separated recipients.
HOMEBASE_ALERT_EMAIL_TO=
# Dashboard address used for links in alert email, for example http://192.0.2.10:8090/
HOMEBASE_DASHBOARD_URL=

# --- Database ---
# Local development (outside Docker). Docker Compose builds its own DATABASE_URL from the POSTGRES_* values below.
DATABASE_URL=postgres://homebase:homebase@localhost:5432/homebase

# --- Docker Compose only ---
# Use a URL-safe password, for example: openssl rand -hex 32
POSTGRES_DB=homebase
POSTGRES_USER=homebase
POSTGRES_PASSWORD=change-me
# Address the dashboard port binds to on the home server. Keep this a LAN address (for example 192.0.2.10)
# or 127.0.0.1. Never 0.0.0.0 on a machine with a public IP: Docker port bindings bypass host firewalls like ufw.
HOMEBASE_BIND_ADDRESS=127.0.0.1
HOMEBASE_PORT=8000
# Seconds between monitor runs (app checks, due provider syncs, alerts).
CHECK_INTERVAL_SECONDS=300

# --- Home server override (deploy/docker-compose.override.example.yml) ---
# Tailscale IP of the server; the dashboard is also published on it (see docs/deploy-home-server.md).
HOMEBASE_TAILSCALE_ADDRESS=
# Host directory deploy/backup.sh writes nightly database dumps to.
HOMEBASE_BACKUP_DIR=

# --- Public demo (see "Demo mode" in README.md) ---
# Read-only pages without a login, fictional data from `manage.py seed_demo`, simulated
# checks and provider syncs. homebase refuses to start with this on while any provider
# token or EMAIL_HOST is set.
DEMO_MODE=false
# A site this instance belongs to, linked from a strip above the header. Empty: no strip.
MAIN_SITE_URL=
